<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/titulo_mapa"
        app:layout_constraintEnd_toStartOf="@+id/zonaMapa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/zonaMapa" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zonaMapa"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivAnillo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="@string/anillo"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/anillo" />

        <ImageView
            android:id="@+id/ivGondor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/gondor"
            android:scaleType="fitCenter"
            app:layout_constraintCircle="@id/ivAnillo"
            app:layout_constraintCircleAngle="0"
            app:layout_constraintCircleRadius="100dp"
            app:srcCompat="@drawable/gondor"
            tools:layout_editor_absoluteX="18dp"
            tools:layout_editor_absoluteY="5dp" />

        <ImageView
            android:id="@+id/ivRohan"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/rohan"
            android:scaleType="fitCenter"
            app:layout_constraintCircle="@id/ivAnillo"
            app:layout_constraintCircleAngle="120"
            app:layout_constraintCircleRadius="100dp"
            app:srcCompat="@drawable/caballo"
            tools:layout_editor_absoluteX="149dp"
            tools:layout_editor_absoluteY="7dp" />

        <ImageView
            android:id="@+id/ivMordor"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/mordor"
            android:scaleType="fitCenter"
            app:layout_constraintCircle="@id/ivAnillo"
            app:layout_constraintCircleAngle="240"
            app:layout_constraintCircleRadius="100dp"
            app:srcCompat="@drawable/mordor"
            tools:layout_editor_absoluteX="12dp"
            tools:layout_editor_absoluteY="116dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tvInstrucciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/seleccionar_region"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/zonaMapa"
        app:layout_constraintEnd_toStartOf="@+id/zonaMapa"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>